package pages

import "path"

templ Service(projectName string, serviceName string, service string, format string, err error) {
  if serviceName == "" {
    <h1>New Service</h1>
  } else {
    <h1>Edit Service: {serviceName}</h1>
  }
  <form method="post" action={templ.SafeURL(path.Join("/", "project", projectName , "service",  serviceName))}>
    if serviceName == "" {
      <label for="service-name">Name: 
        <input id="service-name" name="name" type="text">
      </label>
    }
    <br/>
    if err != nil {
      <span style="color: red;">{err.Error()}</span>
      <br/>
    }
    <input type="hidden" name="format" value={format} />
    if format == "json" {
      <a href={templ.SafeURL(path.Join("/", "project", projectName, "service", serviceName, "edit") + "?format=yaml")} >YAML</a>
      <br/>
    } else {
      <a href={templ.SafeURL(path.Join("/", "project", projectName, "service", serviceName, "edit") + "?format=json")} >JSON</a>
      <br/>
    }
    <input type="hidden" name="format" value={format} />
    <label for="service-detail">
      {format}:
      <textarea id="service-detail" name={format}>
      if service != "" {
        {service}
      } else if format  == "json" {
        {"{}"}
      }
      </textarea>
    </label>
    <br/>
    <button type="submit">Submit</button>
  </form>
  <br/>
  <a href={templ.SafeURL(path.Join("/", "project", projectName, "route", serviceName))} >Edit Route</a>
}