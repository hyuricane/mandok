package pages

import "inovasiriset.co.id/docker/manager/app/lib/compose"
import "strconv"
import "encoding/json"
import "bytes"
import "time"
import "path"

templ Statuses(projectStats map[string]compose.ExpectedPSData) {
  <h2>Statuses</h2>
  <table>
    <thead>
      <tr>
        <th>Service</th>
        <th>State</th>
        <th>Created At</th>
        <th>Running For</th>
        <th>Health</th>
      </tr>
    </thead>
    <tbody>
      for n, v := range projectStats {
        {{
          td, _ := time.Parse("2006-01-02 15:04:05 -0700 MST", v.CreatedAt)
        }}
        <tr>
          <td>{n}</td>
          <td>{v.State}</td>
          <td>{td.Local().Format("2006-01-02 15:04:05 MST")}</td>
          <td>{v.RunningFor}</td>
          <td>{v.Status}</td>
        </tr>
      }
    </tbody>
  </table>
}

templ Routes(routes map[string]compose.ServiceRoute) {
  <h2>Routes</h2>
  <table>
    <thead>
      <tr>
        <th>Service</th>
        <th>Domain</th>
        <th>Port</th>
        <th>Stikcy</th>
      </tr>
    </thead>
    <tbody>
      for n, v := range routes {
        <tr>
          <td>{n}</td>
          <td>{v.Domain}</td>
          if v.Port != 0 {
            <td>{strconv.Itoa(v.Port)}</td>
          } else {
            <td>Exposed Default</td>
          }
          if len(v.Sticky) == 0 {
            <td>none</td>
          } else {
            {{
              buff := bytes.NewBuffer(nil)
              enc := json.NewEncoder(buff)
              enc.SetEscapeHTML(true)
              enc.SetIndent("  ", "  ")
              enc.Encode(v.Sticky)
            }}
            <td>{buff.String()}</td>
          }
        </tr>
      }
    </tbody>
  </table>
}


templ Project(name string, projectStats map[string]compose.ExpectedPSData, routes map[string]compose.ServiceRoute) {
  <body>
    <h1>{name}</h1>
    @Statuses(projectStats)
    @Routes(routes)
  </body>
}

templ NewProject(err error) {
  <h1>New Project</h1>
  <form method="post" action={templ.SafeURL(path.Join("/", "project-new"))}>
    <label for="project-name">Name: 
      <input id="project-name" name="name" type="text">
    </label>
    <br/>
    if err != nil {
      <span style="color: red;">{err.Error()}</span>
      <br/>
    }
    <label for="project-detail">
      JSON:
      <textarea id="project-detail" name="json">
      {"{}"}
      </textarea>
    </label>
    <br/>
    <button type="submit">Submit</button>
  </form>
}