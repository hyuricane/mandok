package pages

import "inovasiriset.co.id/docker/manager/app/lib/compose"
import "path"
import "inovasiriset.co.id/docker/manager/web/handlers/templates/components"
import "inovasiriset.co.id/docker/manager/web/handlers/templates/layouts"

templ Project(projectName string, projectStats map[string]compose.ServiceStatus, envPlain, envSecret map[string]string) {
  @layouts.MainLayout(projectName, []layouts.Breadcrumb{
    { Text: "Home", Link: "/" },
    { Text: projectName },
  }...){
    <h1>{projectName}</h1>
    <div>
      <a href={templ.SafeURL(path.Join("/", "project", projectName, "start"))}>Start All</a>
      <a href={templ.SafeURL(path.Join("/", "project", projectName, "down"))}>Down</a>
      <a href={templ.SafeURL(path.Join("/", "project", projectName, "edit"))}>Edit</a>
    </div>
    @components.Statuses(projectName, projectStats)
    @components.Envs(projectName, envPlain, envSecret)
  }
}

templ NewProject(err error) {
  @layouts.MainLayout("New Project",[]layouts.Breadcrumb{
    { Text: "Home", Link: "/" },
    { Text: "New Project" },
  }...){
  <h1>New Project</h1>
  <form method="post" action={templ.SafeURL(path.Join("/", "project-new"))} enctype="multipart/form-data">
    <label for="project-name">Name: 
      <input id="project-name" name="name" type="text" required>
    </label>
    <br/>
    if err != nil {
      <span style="color: red;">{err.Error()}</span>
      <br/>
    }
    <br/>
    <button type="submit">Submit</button>
  </form>
  }
}


templ EditProject(projectName, project string, format string, err error) {
  @layouts.MainLayout(projectName + ": Edit Raw", []layouts.Breadcrumb{
    { Text: "Home", Link: "/" },
    { Text: projectName, Link: path.Join("/project", projectName) },
    { Text: "Edit Raw" },
  }...){
  <h1>Edit Project: {projectName}</h1>
  
  <form method="post" action={templ.SafeURL(path.Join("/", "project", projectName, "edit"))}>
    if err != nil {
      <span style="color: red;">{err.Error()}</span>
      <br/>
    }
    <input type="hidden" name="format" value={format} />
    if format == "json" {
      <a href={templ.SafeURL(path.Join("/", "project", projectName, "edit") + "?format=yaml")} >YAML</a>
      <br/>
    } else {
      <a href={templ.SafeURL(path.Join("/", "project", projectName, "edit") + "?format=json")} >JSON</a>
      <br/>
    }
    <label for="service-detail">
      {format}:
      <textarea id="service-detail" name={format}>
      if project != "" {
        {project}
      } else if format == "json" {
        {"{}"}
      }
      </textarea>
    </label>
    <br/>
    <button type="submit">Submit</button>
  </form>
  }
}