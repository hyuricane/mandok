package layouts

type Breadcrumb struct {
  Text string
  Link string
}

templ MainLayout(title string, breadcrumbs ...Breadcrumb) {
  <html>
  <head>
  <title>{title}</title>
  </head>
  <body>
      for i, b := range breadcrumbs {
        if i != 0 {
          {" / "}
        }
        if b.Link != "" {
          <a href={templ.SafeURL(b.Link)}>{b.Text}</a>
        } else {
          <span>{b.Text}</span>
        }
      }
      {children...}
  </body>
  </html>
}