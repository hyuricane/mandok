package pages

import "inovasiriset.co.id/docker/manager/web/templates/layouts"
import "inovasiriset.co.id/docker/manager/web/templates/htmxs/components"

templ Login(layout bool, username string, err error) {
  if layout {
    @layouts.HTMX() {
      @hxLogin(username, err)
    }
  } else {
    @hxLogin(username, err)
  }
}

templ hxLogin(username string, err error) {
  <title>Login</title>
  <div id="page">
    <form hx-post="#" method="post" hx-target="#page">
      <table>
        <tr>
          <td>
            <label for="login_username">
              Username
            </label>
          </td>
          <td>
            <input id="login_username" name="username" value={ username }>
          </td>
        </tr>
        <tr>
          <td>
            <label for="login_password">
              Password
            </label>
          </td>
          <td>
            <input id="login_password" name="password" type="password">
          </td>
        </tr>
      </table>
      @components.Error(err)
      <button type="submit">Login</button>
    </form>
  </div>
}