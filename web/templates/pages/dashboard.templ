package pages

import "path"
import "inovasiriset.co.id/docker/manager/web/templates/layouts"

templ Dashbaord(projects []string) {
  @layouts.MainLayout("Mandok") {
    <h1>Projects</h1>
    <ul hx-boost="true">
    for _, p := range projects {
      <li><a href={templ.SafeURL(path.Join("/", "project", p))} hx-target="body">{p}</a></li>
    }
    </ul>

    <a type="button" href={templ.SafeURL("/project-new")} >New Project</a>
  }
}