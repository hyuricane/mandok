package components

import (
	"fmt"
	"inovasiriset.co.id/docker/manager/app/lib/compose"
	"path"
	"sort"
)

type ActionButton struct {
	Icon    templ.Component
	BgColor string
	Name    string
	URL     string
	Target  string
	Push    bool
	NewTab  bool
}

templ RenderActionButton(action ActionButton, lite bool) {
	if action.NewTab {
		<a
			href={ templ.SafeURL(action.URL) }
			target="_blank"
			class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-700"
			@click="open = false"
		>
			@action.Icon
			if !lite {
				{ action.Name }
			}
		</a>
	} else {
		<a
			href={ templ.SafeURL(action.URL) }
			x-target={ action.Target }
			if action.Push {
				x-target.push={ action.Target }
			}
			class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-700"
			@ajax.before="open = false"
		>
			@action.Icon
			if !lite {
				{ action.Name }
			}
		</a>
	}
}

templ editIcon() {
	<svg class="mr-3 h-5 w-5 text-gray-400 group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
	</svg>
}

templ stopIcon() {
	<svg class="mr-3 h-5 w-5 text-gray-400 group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"></path>
	</svg>
}

templ startIcon() {
	<svg class="mr-3 h-5 w-5 text-gray-400 group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
	</svg>
}

templ restartIcon() {
	<svg class="mr-3 h-5 w-5 text-gray-400 group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
	</svg>
}

templ logIcon() {
	<svg class="mr-3 h-5 w-5 text-gray-400 group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
	</svg>
}

templ pullIcon() {
	<svg class="mr-3 h-5 w-5 text-gray-400 group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
	</svg>
}

templ softStartIcon() {
	<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"></path></svg>
}

templ ActionButtons(projectName string, serviceName string, state string, popupPosition string) {
	{{
		actions := []ActionButton{
			{
				Name:   "edit",
				URL:    path.Join("/ax", "project", projectName, "service", serviceName, "edit"),
				Target: "page",
				Push:   true,
				Icon:   editIcon(),
			},
			{
				Name:   "start",
				URL:    path.Join("/ax", "project", projectName, "service", serviceName, "start"),
				Target: "project-status",
				Icon:   startIcon(),
			},
		}
		if state == "running" {
			actions = append(actions, ActionButton{
				Name:   "restart",
				URL:    path.Join("/ax", "project", projectName, "service", serviceName, "start") + "?restart=true",
				Icon:   restartIcon(),
				Target: "project-status",
			}, ActionButton{
				Name:   "stop",
				URL:    path.Join("/ax", "project", projectName, "service", serviceName, "stop"),
				Icon:   stopIcon(),
				Target: "project-status",
			})
		}
		actions = append(actions, ActionButton{
			Name:   "pull",
			URL:    path.Join("/ax", "project", projectName, "service", serviceName, "start") + "?pull=true",
			Icon:   pullIcon(),
			Target: "project-status",
		})
		if state != "" {
			actions = append(actions, ActionButton{
				Name:   "log",
				URL:    path.Join("/ax", "project", projectName, "service", serviceName, "log"),
				Icon:   logIcon(),
				Target: "",
				NewTab: true,
			})
		}
		if len(actions) == 0 {
			return
		}
	}}
	<div x-data="{ open: false }" class="relative inline-block text-left">
		<button
			@click="open = !open"
			@click.away="open = false"
			class="text-gray-500 hover:text-gray-700 focus:outline-none p-1 rounded-full hover:bg-gray-100 transition-colors"
			type="button"
		>
			<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
				<path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"></path>
			</svg>
		</button>
		<div
			x-show="open"
			x-transition:enter="transition ease-out duration-100"
			x-transition:enter-start="transform opacity-0 scale-95"
			x-transition:enter-end="transform opacity-100 scale-100"
			x-transition:leave="transition ease-in duration-75"
			x-transition:leave-start="transform opacity-100 scale-100"
			x-transition:leave-end="transform opacity-0 scale-95"
			class={ fmt.Sprintf("absolute right-0 mt-2 rounded-md shadow-lg bg-white/50 ring-1 ring-black ring-opacity-5 z-50 divide-y divide-gray-100 focus:outline-none %s", popupPosition) }
			style="display: none;"
		>
			<div class="py-1">
				for _, action := range actions {
					@RenderActionButton(action, false)
				}
			</div>
		</div>
	</div>
}

templ Statuses(projectName string, projectStats map[string]compose.ServiceStatus, err error) {
	{{
		projectStatsArr := []compose.ServiceStatus{}
		for _, v := range projectStats {
			projectStatsArr = append(projectStatsArr, v)
		}
		sort.Slice(projectStatsArr, func(i, j int) bool {
			return projectStatsArr[i].Name < projectStatsArr[j].Name
		})
	}}
	<div id="project-status" class="container p-4 overflow-x-auto overflow-y-visible">
		<h2 class="text-2xl font-bold mb-4">Statuses</h2>
		<table class="w-full divide-y divide-gray-200 table-fixed">
			<thead class="bg-gray-50">
				<tr>
					<th scope="col" class="w-2/12 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Service</th>
					<th scope="col" class="w-3/12 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Image</th>
					<th scope="col" class="w-1/12 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Running</th>
					<th scope="col" class="w-2/12 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">State</th>
					<th scope="col" class="w-3/12 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Route</th>
					<th scope="col" class="w-1/12 px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				for i, v := range projectStatsArr {
					{{
						popupPosition := "origin-top-right absolute right-0 mt-2"
						if len(projectStatsArr)/2 < i {
							popupPosition = "origin-bottom-right absolute right-0 mt-2"
						}
					}}
					<tr id={ fmt.Sprintf("project-status-%s", v.Name) } class="hover:bg-gray-100">
						<td class="px-6 py-2 whitespace-nowrap">{ v.Name }</td>
						<td class="px-6 py-2 break-all">{ v.Image }</td>
						<td class="px-6 py-2 whitespace-nowrap">{ fmt.Sprintf("%d/%d", v.Running, v.Expected) }  </td>
						<td class="px-6 py-2 whitespace-nowrap">{ v.State }</td>
						<td class="px-6 py-2 break-normal">
							if v.Route != "" {
								<a href={ templ.SafeURL("//" + v.Route) } target="_blank" class="text-blue-500 hover:underline">{ v.Route }</a> | 
								<a
									href={ templ.SafeURL(path.Join("/ax", "project", projectName, "route", v.Name)) }
									x-target="page"
									x-target.push="page"
									class="text-blue-500 hover:underline mr-2"
								>
									Edit
								</a>
							} else {
								<a
									href={ templ.SafeURL(path.Join("/ax", "project", projectName, "route", v.Name)) }
									x-target="page"
									x-target.push="page"
									class="text-blue-500 hover:underline mr-2"
								>
									Add Route
								</a>
							}
						</td>
						<td class="px-6 py-2 whitespace-nowrap">
							@ActionButtons(projectName, v.Name, v.State, popupPosition)
						</td>
					</tr>
				}
				if err != nil {
					<tr>
						<td colspan="6" class="px-6 py-2 whitespace-nowrap">
							@Error(err, "status-err")
						</td>
					</tr>
				}
			</tbody>
			<tfoot>
				<tr>
					<td colspan="6" class="px-6 py-4 whitespace-nowrap">
						<a
							href={ templ.SafeURL(path.Join("/ax", "project", projectName, "service-new")) }
							x-target="page"
							x-target.push="page"
							class="mt-4 bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded"
						>
							New Service
						</a>
					</td>
				</tr>
			</tfoot>
		</table>
	</div>
}
