package pages

import "inovasiriset.co.id/docker/manager/web/templates/layouts"
import "inovasiriset.co.id/docker/manager/web/templates/axs/components"

templ contentLogin(username string, err error) {
	<title>Login</title>
	<div id="page" class="container p-4">
		<form x-target.push="page" method="POST" action="/ax/login" class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4 w-fit mx-auto">
			<table>
				<tr>
					<td>
						<label for="login_username" class="block text-gray-700 mb-2 mr-4">
							Username
						</label>
					</td>
					<td>
						<input id="login_username" name="username" value={ username } class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" required/>
					</td>
				</tr>
				<tr>
					<td>
						<label for="login_password" class="block text-gray-700 mb-2 mr-4">
							Password
						</label>
					</td>
					<td>
						<input id="login_password" name="password" type="password" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" required/>
					</td>
				</tr>
			</table>
			@components.Error(err, "login-err")
			<button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline">Login</button>
		</form>
	</div>
}

templ Login(layout bool, username string, err error) {
	if layout {
		@layouts.AX("Login") {
			<div id="page" x-sync class="container p-4">
				@contentLogin(username, err)
			</div>
		}
		{{ return }}
	}
	<div id="page" x-sync class="container p-4">
		@contentLogin(username, err)
	</div>
}
