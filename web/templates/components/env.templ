package components

import "inovasiriset.co.id/docker/manager/app/lib/compose"
import "path"

templ Envs(projectName string, envVals []compose.EnvVal) {
  <h2>Envs</h2>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Value</th>
        <th>...</th>
      </tr>
    </thead>
    <tbody>
      for _, v := range envVals {
        <tr>
          <td>{v.Key}</td>
          <td>{v.Val}</td>
          <td>
            <a href={templ.SafeURL(path.Join("/", "project", projectName, "env", "delete", v.Key))}>delete</a> |
            <a href={templ.SafeURL(path.Join("/", "project", projectName, "env", "secret", v.Key))}>secret</a>
          </td>
        </tr>
      }
    </tbody>
    <tfoot>
      <form action={templ.SafeURL(path.Join("/", "project", projectName, "env", "plain"))} method="post">
        <tr>
          <td><input name="name" /></td>
          <td><input name="value"/></td>
          <td><button type="submit">+</button></td>
        </tr>
      </form>
    </tfoot>
  </table>
  <form action={templ.SafeURL(path.Join("/", "project", projectName, "env"))} method="post">
    <label for="plain_envs">envs:</label>
    <br/>
    <textarea id="plain_envs" name="envs"></textarea>
    <br/>
    <button type="submit">add all</button>
  </form>
}