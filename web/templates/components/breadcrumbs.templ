package components

type Breadcrumb struct {
	Text string
	Link string
}

templ Breadcrumbs(breadcrumbs ...Breadcrumb) {
  <div id="breadcrumbs">
    for i, b := range breadcrumbs {
      if i != 0 {
        {" / "}
      }
      if b.Link != "" {
        <a href={templ.SafeURL(b.Link)}>{b.Text}</a>
      } else {
        <span>{b.Text}</span>
      }
    }
  </div>
}